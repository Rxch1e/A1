        {
          "name": "Signup student",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const keys = ['student_username', 'student_email', 'student_password', 'student_token', 'admin_token', 'event_date', 'log_id', 'log2_id', 'prize_id_tshirt', 'prize_id_recognition', 'redemption_id'];",
                  "keys.forEach(function (key) { pm.collectionVariables.unset(key); });",
                  "const ts = Date.now();",
                  "const username = 'student_' + ts;",
                  "const password = 'StudentPass123!';",
                  "pm.collectionVariables.set('student_username', username);",
                  "pm.collectionVariables.set('student_email', username + '@example.com');",
                  "pm.collectionVariables.set('student_password', password);",
                  "const d = new Date();",
                  "d.setDate(d.getDate() - 2);",
                  "pm.collectionVariables.set('event_date', d.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('username');",
                  "  pm.expect(json).to.have.property('email');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.username) { pm.collectionVariables.set('student_username', json.username); }",
                  "if (json && json.email) { pm.collectionVariables.set('student_email', json.email); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{student_username}}\",\n  \"email\": \"{{student_email}}\",\n  \"password\": \"{{student_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "signup"
